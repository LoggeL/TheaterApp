HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/theater.sqlite
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/firebase-service-account.json
AUTH_PROVIDERS=password,google.com
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BOOTSTRAP_ADMIN_EMAIL=
SCRIPT_SERVICE_URL=https://skript.logge.top/
MOBILE_PUSH_ENABLED=false
# Termin-Kisten: hours after an event's end until the own commitments become its attendance
# (default 24), and minutes after the end until the reminder to record it (default 30).
# ATTENDANCE_AUTO_ADOPT_HOURS=24
# ATTENDANCE_REMINDER_MINUTES=30
WEB_APP_DIR=../build/web
# Local development only; never set this in production:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
APP_ORIGIN=https://app.kolpingtheater-ramsen.de
RESEND_API_KEY_FILE=/absolute/private/path/resend-api-key
EMAIL_FROM="Kolpingtheater Ramsen <app-noreply@kolpingtheater-ramsen.de>"
EMAIL_REPLY_TO=kolpingtheaterramsen@gmail.com
SCRIPT_CACHE_DIR=./data/mobile-script-cache
SCRIPT_FOCUS_BRIDGE=false
# Required only when sharing the existing Skript browser session:
# SCRIPT_DIRECTOR_PASSWORD_FILE=/absolute/private/path/script-director-password

# Comma-separated HTTPS hosts allowed for Immich shared albums.
GALLERY_HOSTS=photo.rittmann.cloud
# Defaults to a media directory beside DATABASE_PATH; keep it on the persistent volume.
# MEDIA_DIR=/data/media
