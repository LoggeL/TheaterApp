HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/theater.sqlite
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/firebase-service-account.json
AUTH_PROVIDERS=password,google.com
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BOOTSTRAP_ADMIN_EMAIL=
SCRIPT_SERVICE_URL=https://skript.logge.top/
MOBILE_PUSH_ENABLED=false
WEB_APP_DIR=../build/web
# Local development only; never set this in production:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
APP_ORIGIN=https://theater-app.logge.top
SCRIPT_CACHE_DIR=./data/mobile-script-cache
SCRIPT_FOCUS_BRIDGE=false
# Required only when sharing the existing Skript browser session:
# SCRIPT_DIRECTOR_PASSWORD_FILE=/absolute/private/path/script-director-password
