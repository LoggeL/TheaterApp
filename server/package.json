{
  "name": "theater-app-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/index.mjs",
    "test": "node --test test/*.test.mjs",
    "emulators": "firebase emulators:start --only auth --project demo-theater-app --config ../firebase.json",
    "bootstrap-admin": "node --env-file-if-exists=.env scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^10.9.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "firebase-tools": "^15.30.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
